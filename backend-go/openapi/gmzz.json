                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Delete one of your characters",
        "tags": [
          "characters"
        ]
      },
      "get": {
        "description": "Open to anyone holding the link unless the character is private. `editable` tells the owner apart. A private character is not found for everyone else, and the uid is withheld from them unless its owner chose to show it.",
        "operationId": "getCharacter",
        "parameters": [
          {
            "description": "The character's public id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The character's public id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeCharacter"
