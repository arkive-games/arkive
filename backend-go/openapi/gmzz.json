    "/characters/{id}/copy": {
      "post": {
        "description": "Your own, or anyone's you can read. A copy of someone else's keeps the inputs and server but not their uid. Counts toward the limit of ten.",
        "operationId": "copyCharacter",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
