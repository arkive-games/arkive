# Arkive backend configuration. Every value below is a default except the two
# secrets, which are required outside DEBUG mode.

DEBUG=false

# Which modules this process serves. Empty means all of them, which is how the
# service runs as a single deployment. Set to one name per process to split it.
# ARKIVE_MODULES=core

SERVER_HOST=0.0.0.0
SERVER_PORT=9000
API_PREFIX=/api/v1

# Either POSTGRES_URL, or the discrete fields below it. The URL wins if set.
# POSTGRES_URL=postgres://arkive:pass@localhost:5432/arkive?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=arkive
POSTGRES_PASSWORD=pass
POSTGRES_DATABASE=arkive
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10

# Required outside DEBUG. Startup fails on an empty or placeholder value rather
# than signing tokens with a string that is public in this file.
JWT_SECRET_KEY=
ALTCHA_HMAC_KEY=

# Scopes session tokens to this service. Arkive's own value, not the Python
# service's "fastapi-users:auth", so tokens issued before the rewrite are
# rejected and every user signs in once more. Passwords are unaffected.
JWT_AUDIENCE=arkive:auth
JWT_LIFETIME=336h
RESET_TOKEN_LIFETIME=1h
VERIFY_TOKEN_LIFETIME=24h

AUTH_COOKIE_NAME=arkive_auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# Scope the session cookie to the parent domain so one sign-in covers the
# homepage and every game subdomain. Without this the cookie is host-only and
# each site gets its own separate login.
#
# The API must live under the same registrable domain (api-arkive.tc-imba.com)
# for the browser to send this on XHR under SameSite=lax.
#
# Leave EMPTY in local development: "localhost" is not a valid cookie domain,
# and cookies ignore ports, so a host-only cookie is already shared across the
# per-app dev ports.
# AUTH_COOKIE_DOMAIN=.tc-imba.com

ALTCHA_MAX_NUMBER=50000
REGISTER_PER_MINUTE=5

# Argon2id parameters. The defaults match what pwdlib writes, so hashes stay
# readable by both services during cutover.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# Comma-separated exact origins. With credentials allowed, "*" means "reflect
# any origin", which is convenient locally and too permissive in production:
# name the sites instead.
#
# Production:
# ALLOWED_ORIGINS=https://tc-imba.com,https://aion2.tc-imba.com,https://palworld.tc-imba.com,https://vrising.tc-imba.com,https://sts2.tc-imba.com,https://lostark.tc-imba.com
#
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=true

# Answers an UNLISTED origin with "*" and explicitly no credentials, instead of
# refusing it. Required for Bilibili Toy sign-in: a Toy runs as a third-party
# iframe where the session cookie is blocked by the browser whatever CORS says,
# so it authenticates with a bearer token and sends no credentials.
#
# This is safe precisely because credentials are refused on that path: no cookie
# can ride such a request, so an unlisted origin cannot reach an existing
# session — only a caller already holding a token can do anything. It does
# expose the unauthenticated endpoints (altcha, register, login) to any origin;
# registration stays gated by proof-of-work and the per-IP rate limit.
#
# Leave false if Toy builds do not need sign-in.
CORS_PUBLIC_FALLBACK=false

# --- Object storage (avatars; later comment and feedback images) ---
# Required outside DEBUG. In DEBUG these default to the MinIO in
# docker-compose.yml, and an absent server only breaks the upload routes.
#
# S3_USE_PATH_STYLE is what separates the two backends. MinIO has no wildcard DNS
# under its host, so the bucket must travel in the request path; Tencent COS
# addresses buckets as <bucket>.cos.<region>.myqcloud.com and needs it off. Note
# the SDK falls back to path style regardless when the endpoint is an IP address.
#
# MinIO (development):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arkive
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
# The address browsers fetch objects from, which is not necessarily the endpoint
# writes go to: put a CDN here in production.
S3_PUBLIC_BASE_URL=http://localhost:9000/arkive

# Tencent COS (production) would instead be:
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_REGION=ap-guangzhou
# S3_BUCKET=<name>-<appid>
# S3_ACCESS_KEY_ID=<SecretId>
# S3_SECRET_ACCESS_KEY=<SecretKey>
# S3_USE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://<cdn-or-bucket-domain>

# Avatar uploads allowed per account per minute.
AVATAR_UPLOADS_PER_MINUTE=5

# Avatar uploads are capped at 1 MB and 3000x3000 pixels, matching GitHub. That
# is deliberately below the reverse proxy body limit in front of this service
# (nginx defaults to 1m; production measured ~2m), so an oversized upload is
# refused here with a message naming the limit rather than by the proxy.

# Preset avatars must be uploaded into the bucket once, so that every site can
# render them and they share the avatar URL scheme:
#   arkive seed-avatars ../frontend/apps/meta/public/images/avatars
