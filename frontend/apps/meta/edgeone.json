{
  "rewrites": [
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/user*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
