# Per-machine paths. All of these are REQUIRED by the tool that consumes them —
# there are no hardcoded fallbacks; a missing variable raises at run time.
# Copy this file to tools/.env and fill in your local paths.

# --- AION2 ---

# Root of the raw UE5 game export consumed by the tools (Perforce-managed later).
RAW_DATA_PATH=G:/NCSoft/Export/Exports/AION2/Content

# Monorepo frontend/ workspace. Defaults to <monorepo>/frontend; set only if
# your checkout layout differs.
# FRONTEND_ROOT=E:/arkive-games/arkive/frontend

# Output repos the frontend reads over HTTP (siblings of this monorepo).
AION2_DATA_OUT=E:/arkive-games/data-aion2
AION2_RES_OUT=E:/arkive-games/resource-aion2

# Only for the legacy one-off scripts (items/parse.py, pets/*): the
# pre-monorepo export root (old layout, UI/ directly under it) and the pets
# screenshot folder. Leave unset unless you run those scripts.
# AION2_LEGACY_EXPORT_ROOT=G:/NCSoft/Export
# AION2_PETS_DIR=G:/NCSoft/pets

# Backend login used by the upload/sync tools (tools/aion2/tools/common/auth.py).
AION2_BACKEND_USERNAME=you@example.com
AION2_BACKEND_PASSWORD=change-me

# --- Palworld ---

# Raw UE export root (…/Content/Pal) consumed by the palworld pipelines.
PALWORLD_RAW=E:/SteamLibrary/steamapps/common/Palworld/Exports/Pal/Content/Pal
# Output repos the frontend reads over HTTP (siblings of this monorepo).
PALWORLD_DATA_OUT=E:/arkive-games/data-palworld
PALWORLD_RES_OUT=E:/arkive-games/resource-palworld

# --- Slay the Spire 2 ---

# gdex export root (models.json + the mirrored res/ pack tree).
# Produced by: gdex export --profile sts2 && gdex models --profile sts2
STS2_RAW=E:/Exports/sts2
# Output repos the frontend reads over HTTP (siblings of this monorepo).
STS2_DATA_OUT=E:/arkive-games/data-sts2
STS2_RES_OUT=E:/arkive-games/resource-sts2

# --- V Rising ---

# unex export root (Texture2D/ + MonoBehaviour/ + guid-index.json).
# Produced by: unex export --profile vrising
VRISING_RAW=D:/SteamLibrary/steamapps/common/VRising/Exports
# Output repos the frontend reads over HTTP (siblings of this monorepo).
VRISING_DATA_OUT=E:/arkive-games/data-vrising
VRISING_RES_OUT=E:/arkive-games/resource-vrising

# Installed game files used by the marker extractor (client + bundled server
# EntityScenes). The two reference files are explicit, reviewable inputs:
# VRISING_PREFABS is github.com/decaprime/VRising-Modding's
# _data/prefabs/All.json; VRISING_VBLOOD is github.com/mfoltz/mfoltz.github.io's
# data/prefabs/VBloodNames.json. Review and pin both inputs before a data build.
VRISING_GAME_ROOT=F:/SteamLibrary/steamapps/common/VRising
VRISING_PREFABS=E:/references/vrising/All.json
VRISING_VBLOOD=E:/references/vrising/VBloodNames.json
VRISING_TECH=E:/references/vrising/Tech.json
VRISING_RECIPES=E:/references/vrising/Recipe.json

# --- Lost Ark ---

# lostark-explorer output: the ClientData/TableData directory of EFTable_*.db
# SQLite files. Produced by: lostark-explorer "Extract All" on the client archives.
LOSTARK_TABLES=D:/lostark-extracted/EFGame/data2/EFGame_Extra/ClientData/TableData
# Output repo the frontend reads over HTTP (sibling of this monorepo).
LOSTARK_DATA_OUT=E:/arkive-games/data-lostark
# Decoded UI icon atlases: one directory per package of PNG pages, as written by
# `laex textures <EFUI_ICONATLAS_*.upk> --out <dir>`. Only needed to re-slice the
# icon sets, not to emit the dataset.
LOSTARK_ICON_ATLAS=E:/arkive-games/lostark-icons-crn
# The client's atlas sprite table: it maps an Icon/IconIndex pair to a page and a
# rectangle, and no arithmetic substitutes for it (see tools/apps/lostark/icons.py).
# Shipped in the data3 layer of the extraction, beside TooltipInfo.loa.
LOSTARK_ICON_INFO=D:/lostark-extracted/EFGame/data3/EFGame_Extra/ClientData/XmlData/IconInfo.loa
# Zone maps, for `python -m lostark maps <mapId>`. One folder per map id holding
# MinimapData.loa (tile grid + per-tile world AABB) and DeployData.loa (placed
# actors). Note this sits under leveldata1, NOT beside the EFTable_*.db files.
LOSTARK_MAPDATA=D:/lostark-extracted/EFGame/leveldata1/Common_Extra/MapData
# Decoded minimap tiles: one directory per EFMINIMAP_* package, as written by
# `laex textures <EFMINIMAP_*.upk> --out <dir>`.
LOSTARK_MAP_ART=E:/arkive-games/lostark-maps

# --- Lord of Mysteries (GMZZ) ---

# uex export root: the C7/... tree written by `uex export --profile gmzz`.
# The pipelines read C7/Content/ScriptOPCode/Data/Excel out of it and decrypt the
# client's LuaJIT tables directly, so no hand-made table export is needed.
GMZZ_RAW=D:/GMZZLauncher/uex-out/gmzz
# Installed client root, optional: only read to stamp the client build number
# (Content/package.txt) into the dataset's version.json.
GMZZ_GAME=D:/GMZZLauncher/Game/C7
# Output repos the frontend reads over HTTP (siblings of this monorepo).
GMZZ_DATA_OUT=E:/arkive-games/data-gmzz
GMZZ_RES_OUT=E:/arkive-games/resource-gmzz

# Installed client root for the equipment-database discovery stage, which reads
# Game/Manifest_UFSFiles_Win64.txt.
GMZZ_CLIENT_ROOT=D:/GMZZLauncher
# Directory of JSON table exports for the equipment database.
GMZZ_TABLE_EXPORT=E:/Exports/lord-of-mysteries/tables
# Local SQLite output. Keep generated databases outside this source repository.
GMZZ_DB_OUT=E:/arkive-games/data-gmzz/gmzz.sqlite
