# Test & tooling artifacts
# `edgeone makers deploy` drops {Name, ProjectId} here to remember which project a
# directory was last pushed to. Local state, and per-machine: the deploy workflow
# passes -n explicitly rather than relying on it.
.edgeone/
.playwright-mcp/
/.playwright-cli/
/output/
test-results/
playwright-report/
.screenshots/
/.scratch/

# Claude local worktrees / settings
.claude/

# Brainstorming visual companion (local mockups)
.superpowers/

# Scratch copies of third-party reference sources (not ours to vendor)
_lostark_ref/

# Local debug screenshots (repo root only)
/*.png

# A crashed `pnpm fonts:sync` can leave its staging directory behind.
frontend/apps/meta/public/fonts/noto-sans/.staging-*
